# Environment Configuration Template
# Copy this file to .env and update the values

# Server Configuration
PORT=3001
NODE_ENV=development

# JWT Secret - CHANGE THIS TO A SECURE RANDOM STRING
# Generate a secure key: openssl rand -base64 32
JWT_SECRET=your-super-secure-jwt-secret-key-at-least-32-characters-long

# Email Configuration (for contact form notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-specific-password

# Database Configuration
# SQLite is used by default, uncomment for other databases
# DATABASE_URL=postgresql://username:password@localhost:5432/digiteck_vision
# DATABASE_URL=mysql://username:password@localhost:3306/digiteck_vision

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Admin Configuration
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads

# Logging
LOG_LEVEL=info
LOG_FILE=server.log

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# Production Settings (uncomment for production)
# SECURE_COOKIES=true
# TRUST_PROXY=true
# HELMET_SETTINGS=strict