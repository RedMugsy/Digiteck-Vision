# Environment Configuration Template
# Copy this file to .env and update the values

# Server Configuration
PORT=3001
NODE_ENV=development

# JWT Secret - CHANGE THIS TO A SECURE RANDOM STRING
# Generate a secure key: openssl rand -base64 32
JWT_SECRET=your-super-secure-jwt-secret-key-at-least-32-characters-long

# CORS Configuration (Update for production deployment)
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Production Frontend URLs (Cloudflare Pages)
# FRONTEND_URL=https://your-domain.pages.dev
# CORS_ORIGIN=https://your-domain.pages.dev

# Cloudflare Turnstile (Get from Cloudflare Dashboard)
# TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Admin Configuration
DEFAULT_ADMIN_USERNAME=admin
# Optional for non-interactive seeding (CI/CD). If omitted, seed script prompts securely.
ADMIN_PASSWORD=change-this-before-seeding

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads

# Logging
LOG_LEVEL=info
LOG_FILE=server.log

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# Production Settings (Enable for Railway deployment)
# SECURE_COOKIES=true
# TRUST_PROXY=true
# HELMET_SETTINGS=strict

# Railway Deployment Notes:
# 1. Set these variables in Railway Dashboard (not in .env file)
# 2. Generate unique JWT_SECRET: openssl rand -base64 64
# 3. Set FRONTEND_URL to your Cloudflare Pages domain
# 4. Get Turnstile keys from Cloudflare Dashboard
# 5. Set ADMIN_PASSWORD in Railway for non-interactive seeding