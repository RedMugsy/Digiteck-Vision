# Frontend Environment Variables Template
# Copy this file to .env for local development
# In production, set these in Cloudflare Pages dashboard

# API Configuration
VITE_API_URL=http://localhost:3001/api
VITE_NODE_ENV=development

# Cloudflare Turnstile (Get from Cloudflare Dashboard)
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Production values (set in Cloudflare Pages):
# VITE_API_URL=https://your-railway-app.railway.app/api
# VITE_NODE_ENV=production
# VITE_TURNSTILE_SITE_KEY=your-production-turnstile-site-key